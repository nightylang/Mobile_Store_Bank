@{ ViewData["Title"] = "Command Center"; }
<div class="space-y-8">
    <div class="border-b border-white/10 pb-4">
        <h2 class="text-2xl font-black tracking-tight text-white">Global Operation Command Root</h2>
        <p class="text-xs text-slate-400">Platform-wide structural analytic metrics across active micro-ledgers.</p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 bg-white/[0.03] border border-white/10 rounded-xl">
            <span class="text-2xs text-slate-500 font-bold uppercase tracking-widest block mb-2">Aggregated System Capitalization</span>
            <span class="text-3xl font-mono text-white font-bold">$@ViewBag.TotalLiquidity?.ToString("N2")</span>
        </div>
        <div class="p-6 bg-white/[0.03] border border-white/10 rounded-xl">
            <span class="text-2xs text-slate-500 font-bold uppercase tracking-widest block mb-2">Authenticated User Footprint</span>
            <span class="text-3xl font-mono text-white font-bold">@ViewBag.ActiveUsersCount Nodes</span>
        </div>
        <div class="p-6 bg-white/[0.03] border border-white/10 rounded-xl">
            <span class="text-2xs text-slate-500 font-bold uppercase tracking-widest block mb-2">CRM Network Latency Tickets</span>
            <span class="text-3xl font-mono text-amber-400 font-bold">@ViewBag.ActiveTickets Tickets</span>
        </div>
    </div>
    <div class="flex gap-4 text-xs font-medium">
        <a href="/Admin/UserList" class="p-3 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition">Modify Node Profiles</a>
        <a href="/Admin/ProdList" class="p-3 bg-white/5 border border-white/10 rounded-lg hover:bg-white/10 transition">Audit Global Vault Items</a>
        <a href="/Admin/CRM" class="p-3 bg-indigo-600/20 text-indigo-300 border border-indigo-500/30 rounded-lg hover:bg-indigo-600/30 transition">Access Resolution Matrix</a>
    </div>
</div>
