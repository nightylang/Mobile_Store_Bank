@model IEnumerable<MobileStoreBank.Models.Wallet>
@{
    ViewData["Title"] = "Ledger Console";
}

<div class="space-y-8">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-white/10 pb-4">
        <div>
            <h2 class="text-2xl font-black text-white tracking-tight">Financial Command Root</h2>
            <p class="text-xs text-slate-400">Consolidated overview of active cross-currency settlement node parameters.</p>
        </div>
        <div class="flex gap-2">
            <a href="/Bank/Wallet" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-500 text-xs font-semibold rounded-lg transition-all shadow-md shadow-indigo-600/20">
                Manage Asset Pools
            </a>
        </div>
    </div>

    <!-- Rapid KPI Statistics Data Cards Matrix -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @foreach (var pool in Model)
        {
            <div class="p-6 bg-white/[0.02] border border-white/10 rounded-xl relative overflow-hidden group">
                <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-white/[0.01] rounded-full group-hover:scale-150 transition-transform duration-500"></div>
                <div class="flex justify-between items-center mb-3">
                    <span class="text-xs font-bold font-mono tracking-widest text-slate-500 uppercase">@pool.AssetName</span>
                    <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full"></span>
                </div>
                <div class="text-2xl font-mono text-white font-bold tracking-tight">
                    $@pool.Balance.ToString("N2")
                </div>
                <div class="mt-2 text-[11px] text-slate-500 font-mono truncate">
                    Addr: @pool.WalletAddress
                </div>
            </div>
        }
    </div>

    <!-- Quick Infrastructure Navigation Triggers -->
    <div class="bg-white/[0.01] border border-white/5 p-4 rounded-xl flex flex-wrap gap-4 text-xs font-medium">
        <span class="text-slate-400 self-center mr-2">Audit Shortcuts:</span>
        <a href="/Bank/History" class="px-3 py-2 bg-white/5 border border-white/10 rounded-md hover:bg-white/10 transition">Immutable Activity Streams</a>
        <a href="/Bank/Account" class="px-3 py-2 bg-white/5 border border-white/10 rounded-md hover:bg-white/10 transition">Security Profile Keys</a>
    </div>
</div>
