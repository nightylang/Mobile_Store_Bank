@model IEnumerable<MobileStoreBank.Models.Wallet>
@{ ViewData["Title"] = "Liquidity Core"; }

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-white/10 pb-4">
        <div>
            <h3 class="text-xl font-black text-white">Liquidity Node Operations Platform</h3>
            <p class="text-xs text-slate-400">High-fidelity display layer containing direct contextual wallet asset tracking pools.</p>
        </div>
    </div>

    <!-- UI State Mapped Matrix Layout -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <!-- USD Card element -->
        <div id="usd-balance-card" class="bg-white/[0.03] border border-white/10 p-5 rounded-xl space-y-4 relative overflow-hidden transition-all duration-300">
            <div class="flex justify-between items-center">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-400">USD Store Settlement Pool</span>
                <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
            </div>
            <div class="space-y-1">
                <div id="usd-balance-display" class="text-3xl font-mono font-bold text-white tracking-tight">
                    $@Model.FirstOrDefault(w => w.AssetName.Contains("USD"))?.Balance.ToString("N2")
                </div>
                <div class="text-2xs font-mono text-slate-500 flex justify-between">
                    <span>Transit Pending Clearance:</span>
                    <span id="pending-clearance-display" class="text-slate-400">+$@Model.FirstOrDefault(w => w.AssetName.Contains("USD"))?.PendingClearance.ToString("N2")</span>
                </div>
            </div>
        </div>

        <!-- BTC Card element -->
        <div class="bg-white/[0.03] border border-white/10 p-5 rounded-xl space-y-4 relative overflow-hidden">
            <div class="flex justify-between items-center">
                <span class="text-xs font-bold uppercase tracking-widest text-slate-400">BTC Secure Vault Node</span>
                <span class="w-1.5 h-1.5 bg-indigo-400 rounded-full"></span>
            </div>
            <div class="space-y-1">
                <div id="btc-balance-display" class="text-3xl font-mono font-bold text-white tracking-tight">
                    @Model.FirstOrDefault(w => w.AssetName.Contains("BTC"))?.Balance.ToString("F8")
                </div>
                <p class="text-2xs font-mono text-slate-600">Primary Cryptographic Storage Vault</p>
            </div>
        </div>

    </div>
</div>
<!-- Real-Time Pure SVG Graph Tracker Component Widget Container -->
<div class="msb-graph-glass-panel">
    <div class="msb-card-header-row">
        <div>
            <h4 class="msb-item-title">Real-Time Platform Settlement Surge Velocity</h4>
            <p class="msb-item-subtitle" style="font-size: 10px; margin-top: 2px;">Asset Lane Tracker: USD Core Ledger Stream</p>
        </div>
        <div class="msb-item-price" style="font-size: 11px; font-weight: bold; font-family: sans-serif; letter-spacing: 0.5px; color: var(--msb-text-muted);">
            Live Feed: 4000ms Poll Cycles
        </div>
    </div>

    <!-- The SVG Drawing Plane Wrapper -->
    <div class="msb-svg-viewport-wrapper">
        <svg id="msb-telemetry-svg" xmlns="http://w3.org">
            <!-- Background horizontal grid structural guidelines -->
            <line x1="0" y1="35" x2="100%" y2="35" stroke="rgba(255,255,255,0.02)" stroke-width="1" />
            <line x1="0" y1="70" x2="100%" y2="70" stroke="rgba(255,255,255,0.02)" stroke-width="1" />
            <line x1="0" y1="105" x2="100%" y2="105" stroke="rgba(255,255,255,0.02)" stroke-width="1" />
            
            <!-- Dynamic Vector Path Element Mapped via State Engine Script -->
            <polyline id="msb-graph-polyline" points="10,70 70,70 130,70 190,70 250,70 310,70" />
        </svg>
    </div>
</div>

@section Scripts {
    <!-- Mount State Script and Boot Polling Operations -->
    <script src="~/js/app-state.js" defer></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // Boot background loop polling every 4 seconds explicitly
            InitializeLedgerPollingLoop(4000);
            if (typeof RenderDashboardGraphTelemetry === "function") {
                RenderDashboardGraphTelemetry();
            }
        });
    </script>
}
