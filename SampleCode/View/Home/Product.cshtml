@{
    ViewData["Title"] = "Catalog Pipeline Intercept";
}

<div class="max-w-3xl mx-auto space-y-8 py-6">
    <div class="text-center space-y-3">
        <div class="inline-flex p-3 bg-cyan-500/10 border border-cyan-500/20 rounded-full text-cyan-400">
            <svg xmlns="http://w3.org" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 11m8 4V5" />
            </svg>
        </div>
        <h2 class="text-3xl font-black text-white tracking-tight">Catalog Navigation Layer Proxy</h2>
        <p class="text-sm text-slate-400 max-w-md mx-auto leading-relaxed">
            Forwarding execution flow path mapping indices to active database context catalog items.
        </p>
    </div>

    <!-- Core Features Micro Glass Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl mx-auto text-xs text-slate-400">
        <div class="p-4 bg-white/[0.01] border border-white/5 rounded-xl space-y-1">
            <span class="text-white font-semibold block text-sm">Hardware & POS Terminals</span>
            Track physical biometrics inventory mapping metrics.
        </div>
        <div class="p-4 bg-white/[0.01] border border-white/5 rounded-xl space-y-1">
            <span class="text-white font-semibold block text-sm">SaaS Micro-Gateway Tokens</span>
            Manage virtual API keys allocating liquidity streams.
        </div>
    </div>

    <div class="text-center pt-2">
        <a href="/Products/Index" class="inline-flex items-center gap-2 px-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 text-sm font-semibold rounded-xl text-white transition-all">
            Execute Real-Time Catalog Fetch Query
            <svg xmlns="http://w3.org" class="h-4 w-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
        </a>
    </div>
</div>
