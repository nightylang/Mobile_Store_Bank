<!-- Inside Views/Products/Index.cshtml replacement loop -->
<div class="bg-gradient-to-br from-purple-950/20 to-slate-900/20 border border-purple-500/20 backdrop-blur-md rounded-2xl p-4 shadow-2xl group relative">
    
    <div class="w-full h-48 bg-slate-900/40 border border-white/5 rounded-xl relative overflow-hidden flex items-center justify-center mb-4">
        <!-- Mock image canvas icon layer -->
        <span class="text-4xl text-purple-500 opacity-40 font-mono font-bold">@row.Category.Substring(0, 3).ToUpper()</span>
        
        <button class="absolute top-3 right-3 p-2 rounded-lg bg-black/40 border border-white/5 text-slate-400 hover:text-purple-400 backdrop-blur-md transition-all">
            <svg xmlns="http://w3.org" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" /></svg>
        </button>
    </div>

    <div class="space-y-1 mb-4">
        <div class="flex justify-between items-start gap-2">
            <h4 class="text-base font-bold text-white group-hover:text-purple-300 transition-colors truncate">@row.Name</h4>
            <span class="font-mono font-bold text-purple-300">$@row.Price.ToString("N2")</span>
        </div>
        <p class="text-2xs font-mono text-purple-400 uppercase tracking-widest">@row.Category &middot; @row.SKU</p>
    </div>

    <div class="grid grid-cols-5 gap-2 border-t border-purple-900/40 pt-3">
        <button class="col-span-1 p-2 flex items-center justify-center rounded-xl bg-white/5 border border-white/10 hover:bg-white/10 text-slate-300 transition-all">
            <svg xmlns="http://w3.org" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z" /></svg>
        </button>
        <button class="col-span-4 p-2 bg-purple-600 hover:bg-purple-500 text-white text-2xs font-bold uppercase tracking-wider rounded-xl transition-all flex items-center justify-center gap-1">
            <span>Commit Order Buy</span>
        </button>
    </div>
</div>
