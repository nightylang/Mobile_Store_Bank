@{
    ViewData["Title"] = "Catalog Categories";
    var dynamicCategories = ViewBag.CategoryData as dynamic;
}

<div class="space-y-6">
    <div class="border-b border-white/10 pb-4">
        <h3 class="text-xl font-black text-white tracking-tight">Structural Category Analytics</h3>
        <p class="text-xs text-slate-400">Real-time density distribution metrics across mapped product groups.</p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        @if (dynamicCategories != null)
        {
            foreach (var category in dynamicCategories)
            {
                <div class="p-5 bg-white/[0.02] border border-white/10 rounded-xl font-mono relative overflow-hidden group shadow-lg">
                    <div class="absolute -right-4 -bottom-4 w-16 h-16 bg-white/[0.01] rounded-full group-hover:scale-150 transition-transform"></div>
                    <div class="text-2xs text-slate-500 uppercase tracking-widest mb-2 block">Segment Classification</div>
                    <div class="flex justify-between items-baseline">
                        <span class="text-base font-sans font-bold text-white truncate pr-2">@category.CatName</span>
                        <span class="text-2xl font-bold text-indigo-400 shrink-0">
                            @category.Count <span class="text-[10px] text-slate-500 font-normal uppercase tracking-wider">SKUs</span>
                        </span>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-span-full p-6 text-center text-xs text-slate-500 font-mono bg-white/[0.01] border border-white/5 rounded-xl">
                No inventory categorization data found in the SQLite memory context.
            </div>
        }
    </div>
    
    <div class="pt-4 text-center">
        <a href="/Products/Index" class="inline-flex items-center gap-1.5 text-xs text-indigo-400 hover:text-indigo-300 transition">
            &larr; Return to Central Catalog System Matrix
        </a>
    </div>
</div>
