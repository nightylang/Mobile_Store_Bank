@model IEnumerable<MobileStoreBank.Data.Product>
@{ ViewData["Title"] = "Store Catalog"; }
<div class="space-y-6">
    <div class="flex justify-between items-center border-b border-white/5 pb-4">
        <div>
            <h2 class="text-xl font-black text-white">Active Merchant Catalog System</h2>
            <p class="text-xs text-slate-400 font-mono">Context Query Targeting: SQLite.DbSet&lt;Product&gt;</p>
        </div>
        <a href="/Products/CRUD" class="px-4 py-2 bg-indigo-600 text-xs font-semibold rounded-lg hover:bg-indigo-500 transition">Scaffold Virtual Asset</a>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        @foreach(var row in Model) {
            <div class="p-5 bg-white/[0.01] border border-white/10 rounded-xl flex justify-between items-center">
                <div class="space-y-1">
                    <span class="text-xs text-indigo-400 font-mono tracking-wider block">@row.Category</span>
                    <h4 class="text-base font-bold text-white">@row.Name</h4>
                    <span class="text-2xs font-mono text-slate-500 block">SKU Identity Key: @row.SKU</span>
                </div>
                <div class="text-right space-y-2">
                    <div class="text-lg font-mono font-bold text-white">$@row.Price.ToString("N2")</div>
                    <span class="px-2 py-0.5 bg-white/5 text-slate-400 text-2xs rounded border border-white/10">Vault Stock: @row.Stock units</span>
                </div>
            </div>
        }
    </div>
</div>


@section Scripts {
    <script src="~/js/app-state.js" defer></script>
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            // 1. Initialize core system listener matrices to intercept buy clicks
            InitializeProductActionListeners();
            
            // 2. Optional: Chain up standard balance background polling synchronization tracking
            if (typeof InitializeLedgerPollingLoop === "function") {
                InitializeLedgerPollingLoop(5000);
            }
        });
    </script>
}
