@model IEnumerable<MobileStoreBank.Models.Product>
@{
    ViewData["Title"] = "Supply Logistics";
}

<div class="space-y-6">
    <div class="flex flex-col sm:flex-row justify-between sm:items-center gap-4 border-b border-white/10 pb-4">
        <div>
            <h3 class="text-xl font-black text-white tracking-tight">Supply Chain Inventory Sync</h3>
            <p class="text-xs text-slate-400">Manage incoming supplier inventory batches and hardware container allocations.</p>
        </div>
        <span class="px-3 py-1 bg-indigo-500/10 text-indigo-400 border border-indigo-500/20 text-xs font-mono rounded-full self-start">
            Active SKUs Monitored: @Model.Count()
        </span>
    </div>

    <!-- Active Logistics Grid -->
    <div class="space-y-3">
        @foreach (var asset in Model)
        {
            <div class="p-4 bg-black/40 border border-white/10 rounded-xl flex flex-col sm:flex-row justify-between sm:items-center gap-4 text-xs font-mono transition-all hover:border-white/20">
                <div class="space-y-1">
                    <span class="text-2xs text-indigo-400 tracking-wider block font-bold uppercase">@asset.SKU</span>
                    <span class="text-sm text-white font-sans font-medium">@asset.Name</span>
                </div>
                <div class="flex items-center justify-between sm:justify-end gap-6 shrink-0 border-t sm:border-t-0 border-white/5 pt-2 sm:pt-0">
                    <div class="space-y-0.5 text-left sm:text-right">
                        <span class="text-slate-500 text-2xs block uppercase tracking-wider">Vault Stock balance:</span>
                        <span class="@(asset.Stock < 20 ? "text-amber-400 font-bold" : "text-emerald-400") text-sm">
                            @asset.Stock units
                        </span>
                    </div>
                    <form method="post" action="/Products/SaveProduct" class="flex gap-2">
                        <input type="hidden" name="Id" value="@asset.Id" />
                        <input type="hidden" name="Name" value="@asset.Name" />
                        <input type="hidden" name="SKU" value="@asset.SKU" />
                        <input type="hidden" name="Category" value="@asset.Category" />
                        <input type="hidden" name="Price" value="@asset.Price" />
                        <input type="hidden" name="Stock" value="@(asset.Stock + 50)" />
                        <button type="submit" class="px-3 py-1.5 bg-white/5 hover:bg-white/10 border border-white/10 rounded-md font-sans text-2xs font-semibold text-slate-300 transition-all">
                            + Restock 50 Units
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>
