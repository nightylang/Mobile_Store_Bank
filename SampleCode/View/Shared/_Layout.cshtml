<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Mobile Store Bank</title>
    <script src="https://tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    backdropBlur: { saas: '16px' }
                }
            }
        }
    </script>
</head>
<body class="min-h-full flex flex-col relative antialiased bg-slate-950 text-slate-100 overflow-x-hidden">

    <!-- Atmospheric Fluid Glow Backdrops -->
    <div class="absolute top-0 left-1/4 w-[500px] h-[500px] bg-indigo-600/10 rounded-full blur-[140px] pointer-events-none z-0"></div>
    <div class="absolute top-1/3 right-1/4 w-[500px] h-[500px] bg-cyan-500/10 rounded-full blur-[140px] pointer-events-none z-0"></div>

    <!-- STICKY GLASS NAVIGATION -->
    <header class="sticky top-0 z-50 w-full border-b border-white/10 bg-slate-900/60 backdrop-blur-saas">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center gap-8">
                <a href="/" class="text-xl font-bold tracking-tight bg-gradient-to-r from-white to-slate-400 bg-clip-text text-transparent">
                    MobileStore<span class="text-indigo-400 font-medium">Bank</span>
                </a>
                <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-slate-400">
                    <a href="/Home/Index" class="hover:text-white transition">Dashboard</a>
                    <a href="/Bank/Wallet" class="hover:text-white transition">Wallets</a>
                    <a href="/Products/Index" class="hover:text-white transition">Products</a>
                    <a href="/Admin/Index" class="hover:text-white transition">Admin Panel</a>
                </nav>
            </div>
            <div class="flex items-center gap-4">
                <a href="/User/Login" class="px-4 py-2 text-sm font-medium text-white bg-indigo-600 hover:bg-indigo-500 rounded-lg shadow-lg shadow-indigo-600/20 transition-all">
                    Access Ledger
                </a>
            </div>
        </div>
    </header>

    <!-- MAIN OPERATIONAL SAAS MAIN CANVAS -->
    <main role="main" class="flex-grow w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 z-10 relative">
        <div class="bg-white/[0.02] border border-white/10 backdrop-blur-md rounded-2xl p-6 sm:p-8 shadow-2xl shadow-black/40">
            @RenderBody()
        </div>
    </main>

    <!-- EXTREME CONTENT FULL WIDTH MEGA FOOTER SYSTEM -->
    <footer class="mt-auto border-t border-white/10 bg-slate-950/90 backdrop-blur-saas relative z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 grid grid-cols-1 md:grid-cols-4 gap-8">
            <div class="space-y-4">
                <span class="text-base font-bold text-white tracking-wider">Mobile Store Bank</span>
                <p class="text-xs text-slate-400 leading-relaxed">
                    Next-generation high-density financial asset node management designed exclusively for automated, high-frequency merchant cleartext HTTP microtransaction routing.
                </p>
            </div>
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">Core Ledger Engine</h4>
                <ul class="space-y-2 text-xs text-slate-400">
                    <li><a href="/Bank/Wallet" class="hover:text-indigo-400 transition">Multi-Asset Wallets</a></li>
                    <li><a href="/Bank/History" class="hover:text-indigo-400 transition">Immutable Activity Logs</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">SaaS Operations</h4>
                <ul class="space-y-2 text-xs text-slate-400">
                    <li><a href="/Products/Index" class="hover:text-indigo-400 transition">Catalog Orchestration</a></li>
                    <li><a href="/Admin/CRM" class="hover:text-indigo-400 transition">Resolution Matrix</a></li>
                </ul>
            </div>
            <div>
                <h4 class="text-xs font-semibold uppercase tracking-wider text-slate-200 mb-4">Infrastructure Status</h4>
                <div class="p-3 bg-white/[0.03] border border-white/10 rounded-xl space-y-2">
                    <div class="flex items-center gap-2 text-emerald-400 text-xs">
                        <span class="w-1.5 h-1.5 bg-emerald-400 rounded-full animate-pulse"></span>
                        HTTP Pipeline: Active
                    </div>
                    <div class="text-[11px] text-slate-500">Target Core Build: .NET 10.0</div>
                </div>
            </div>
        </div>
        <div class="border-t border-white/5 bg-black/30 py-4 text-center text-xs text-slate-500">
            &copy; @DateTime.UtcNow.Year Mobile Store Bank Global Systems Group. Unencrypted HTTP Deployment Template.
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
